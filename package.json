{
  "name": "wrapper",
  "version": "0.0.1",
  "private": true,
  "description": "Starter kit for modern web applications, extended into a lab of experimental microapps",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n host,chat-remote -c blue,green \"npm:dev:host\" \"npm:dev:chat-remote\"",
    "dev:host": "npm run dev --workspace=apps/host",
    "dev:chat-remote": "npm run dev --workspace=apps/chat-remote",
    "build": "npm run build --workspace=apps/chat-remote && npm run build --workspace=apps/host",
    "build:host": "npm run build --workspace=apps/host",
    "build:chat-remote": "npm run build --workspace=apps/chat-remote",
    "preview": "concurrently -n host,chat-remote -c blue,green \"npm:preview:host\" \"npm:preview:chat-remote\"",
    "preview:host": "npm run preview --workspace=apps/host",
    "preview:chat-remote": "npm run preview --workspace=apps/chat-remote",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.24.0",
    "eslint-plugin-react": "^7.31.8",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "2.7.1",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "apps/*/src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "apps/*/src/**/*.{js,jsx,ts,tsx,json}": [
      "eslint --max-warnings=0"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "Suren Atoyan",
    "email": "contact@surenatoyan.com",
    "url": "http://surenatoyan.com/"
  },
  "keywords": [
    "react",
    "pwa",
    "starter-kit",
    "vite",
    "module-federation"
  ]
}
